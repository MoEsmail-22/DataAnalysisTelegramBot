# Telegram bot token from BotFather
BOT_TOKEN=

# Supabase PostgreSQL connection string (not the https:// project URL)
DATABASE_URL=

# Comma-separated Telegram IDs allowed to administer customer data
ADMIN_IDS=

# A random value using only letters, numbers, _ or -. Keep it private.
TELEGRAM_WEBHOOK_SECRET=

# Set this after Vercel deployment, for example:
# https://your-project.vercel.app/api/webhook
WEBHOOK_URL=

# Optional import tuning
DB_UPSERT_CHUNK_SIZE=250
STORE_RAW_DATA=false
