BOT_TOKEN=replace_with_new_token_from_botfather
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
ADMIN_IDS=123456789,987654321
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_NAME=Data
SYNC_INTERVAL_MINUTES=5
DB_UPSERT_CHUNK_SIZE=250
STORE_RAW_DATA=false
GOOGLE_SYNC_DELETE_MISSING=true

# Recommended for small deployed servers:
GOOGLE_SHEETS_CREDENTIALS_PATH=./service-account.json

# Alternatives:
# GOOGLE_SHEETS_CREDENTIALS_BASE64=base64_encoded_service_account_json
# GOOGLE_SHEETS_CREDENTIALS={"type":"service_account",...}
 
# Google Sheets Sync (REQUIRED)
# To set up:
# 1. Create a Google Cloud Project and enable Google Sheets API
# 2. Create a Service Account and download JSON key
# 3. Share the Google Sheet with the service account email
# 4. Set these variables:

GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}
# Or store a path to the JSON file instead of putting the JSON directly into .env:
# GOOGLE_SHEETS_CREDENTIALS_PATH=/path/to/service-account.json
GOOGLE_SHEET_ID=1kc_LVn-KyxUuBhY37rLpC5BvkfCC15MiTbEfLS5055w
GOOGLE_SHEET_NAME=Data
SYNC_INTERVAL_MINUTES=10
